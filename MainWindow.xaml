<Window x:Class="PoE2Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PoE2Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Shared dark glass background brush -->
        <SolidColorBrush x:Key="PanelBg" Color="#1A1A2E" Opacity="0.93" />
        <SolidColorBrush x:Key="PanelBorder" Color="#FFFFFF" Opacity="0.15" />
        <SolidColorBrush x:Key="SeparatorBrush" Color="#FFFFFF" Opacity="0.12" />
        <SolidColorBrush x:Key="DimText" Color="#777777" />
        <SolidColorBrush x:Key="SubText" Color="#AAAAAA" />
        <SolidColorBrush x:Key="BrightText" Color="#DDDDDD" />
        <SolidColorBrush x:Key="AccentGreen" Color="#44DD88" />
        <SolidColorBrush x:Key="AccentGold" Color="#E8C87E" />
        <SolidColorBrush x:Key="ErrorRed" Color="#CC6666" />
        <SolidColorBrush x:Key="ModBlue" Color="#6688FF" />
        <SolidColorBrush x:Key="ImplicitPurple" Color="#8888CC" />
        <SolidColorBrush x:Key="StatCyan" Color="#7799CC" />

        <!-- Button style for action buttons -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close button style -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12">
                            <TextBlock Text="&#x2715;"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" FontSize="12" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FF4444" />
                                <Setter Property="Foreground" Value="#FF6666" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel>
        <!-- ═══════════════════════════════════════════════════ -->
        <!-- ITEM TOOLTIP                                        -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border x:Name="ItemTooltip"
                Visibility="Collapsed"
                Padding="16,12,16,12"
                CornerRadius="10"
                Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                MinWidth="280"
                MaxWidth="440">
            <StackPanel>
                <!-- Header row: item name + close button -->
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}"
                            Click="CloseButton_OnClick" VerticalAlignment="Top" Margin="8,0,0,0" />
                    <StackPanel>
                        <TextBlock x:Name="ItemNameText"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentGold}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="ItemBaseText"
                                   FontSize="12" Foreground="{StaticResource SubText}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- Separator -->
                <Rectangle Height="1" Fill="{StaticResource SeparatorBrush}" Margin="0,8,0,8" />

                <!-- Item info -->
                <TextBlock x:Name="ItemInfoText" FontSize="11"
                           Foreground="{StaticResource DimText}" TextWrapping="Wrap" />

                <!-- Stats -->
                <TextBlock x:Name="ItemStatsText" FontSize="11"
                           Foreground="{StaticResource StatCyan}"
                           Margin="0,4,0,0" TextWrapping="Wrap" />

                <!-- Implicit mods -->
                <TextBlock x:Name="ImplicitModsText" FontSize="11"
                           Foreground="{StaticResource ImplicitPurple}"
                           Margin="0,6,0,0" TextWrapping="Wrap" />

                <!-- Explicit mods -->
                <TextBlock x:Name="ExplicitModsText" FontSize="11"
                           Foreground="{StaticResource ModBlue}"
                           Margin="0,4,0,0" TextWrapping="Wrap" />

                <!-- Price separator -->
                <Rectangle Height="1" Fill="{StaticResource SeparatorBrush}" Margin="0,10,0,8" />

                <!-- Loading indicator -->
                <TextBlock x:Name="PriceLoadingText"
                           Text="Fetching price..."
                           FontSize="13" Foreground="{StaticResource SubText}"
                           FontStyle="Italic" Visibility="Collapsed" />

                <!-- Price display -->
                <TextBlock x:Name="PriceText"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource AccentGreen}"
                           Visibility="Collapsed" />

                <!-- Listing count -->
                <TextBlock x:Name="ListingCountText"
                           FontSize="11" Foreground="{StaticResource DimText}"
                           Margin="0,2,0,0" Visibility="Collapsed" />

                <!-- Error text -->
                <TextBlock x:Name="PriceErrorText"
                           FontSize="12" Foreground="{StaticResource ErrorRed}"
                           Visibility="Collapsed" TextWrapping="Wrap" />

                <!-- Action buttons row -->
                <StackPanel x:Name="ActionButtonsPanel" Orientation="Horizontal"
                            Margin="0,10,0,0" Visibility="Collapsed">
                    <Button Content="Expand Listings" Style="{StaticResource ActionButton}"
                            Click="ExpandButton_OnClick" x:Name="ExpandButton" />
                    <Button Content="Open on Trade Site" Style="{StaticResource ActionButton}"
                            Click="OpenTradeButton_OnClick" Margin="8,0,0,0" />
                </StackPanel>

                <!-- ═══════════════════════════════════════════ -->
                <!-- EXPANDED LISTINGS PANEL                     -->
                <!-- ═══════════════════════════════════════════ -->
                <Border x:Name="ListingsPanel" Visibility="Collapsed"
                        Margin="0,10,0,0" Padding="0"
                        CornerRadius="6" Background="#11FFFFFF">
                    <StackPanel>
                        <Rectangle Height="1" Fill="{StaticResource SeparatorBrush}" />
                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto"
                                      Margin="0,4,0,0">
                            <StackPanel x:Name="ListingsContainer" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Auto-dismiss hint -->
                <TextBlock x:Name="DismissHintText"
                           Text="Press Escape to close"
                           FontSize="9" Foreground="#444444"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- CONTROL BAR: Start/Stop + Status + Gear             -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Background="#CC1A1A2E" CornerRadius="8" Padding="6,4" Margin="0,4,0,0">
            <DockPanel>
                <!-- Gear button on the right -->
                <Button x:Name="GearButton"
                        DockPanel.Dock="Right"
                        Click="GearButton_OnClick"
                        Width="28" Height="28"
                        Cursor="Hand" ToolTip="Settings">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse x:Name="BgEllipse" Fill="Transparent" Width="28" Height="28" />
                                <TextBlock Text="&#x2699;" FontSize="16" Foreground="#AAAAAA"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BgEllipse" Property="Fill" Value="#33FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Start/Stop toggle on the left -->
                <Button x:Name="ToggleMonitorButton"
                        DockPanel.Dock="Left"
                        Click="ToggleMonitorButton_OnClick"
                        Content="&#x25B6;"
                        Width="28" Height="28"
                        Cursor="Hand" ToolTip="Start monitoring">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse x:Name="BgEllipse" Fill="Transparent" Width="28" Height="28" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BgEllipse" Property="Fill" Value="#33FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Compare mode toggle -->
                <Button x:Name="CompareModeButton"
                        DockPanel.Dock="Left"
                        Click="CompareModeButton_OnClick"
                        Content="&#x2696;"
                        Width="28" Height="28"
                        Cursor="Hand" ToolTip="Switch to Compare mode"
                        Margin="4,0,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse x:Name="BgEllipse" Fill="Transparent" Width="28" Height="28" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BgEllipse" Property="Fill" Value="#33FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Status text in the middle -->
                <TextBlock x:Name="StatusText" Text="Stopped"
                           FontSize="11" Foreground="#777777"
                           VerticalAlignment="Center" Margin="6,0"
                           HorizontalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- SETTINGS PANEL                                      -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border x:Name="SettingsPanel"
                Visibility="Collapsed"
                Margin="0,4,0,0"
                Padding="16"
                CornerRadius="10"
                Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                MinWidth="280">
            <StackPanel>
                <!-- Header -->
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}"
                            Click="SettingsCloseButton_OnClick" />
                    <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource BrightText}" />
                </DockPanel>

                <!-- League -->
                <TextBlock Text="League" FontSize="11" Foreground="{StaticResource DimText}"
                           Margin="0,0,0,4" />
                <ComboBox x:Name="LeagueComboBox" FontSize="12"
                          SelectionChanged="LeagueComboBox_OnSelectionChanged"
                          Background="#22FFFFFF" Foreground="Black"
                          Height="28" />

                <!-- Auto-dismiss -->
                <TextBlock FontSize="11" Foreground="{StaticResource DimText}" Margin="0,12,0,4">
                    <Run Text="Auto-dismiss: " />
                    <Run x:Name="AutoDismissValueText" Text="15" />
                    <Run Text="s" />
                </TextBlock>
                <Slider x:Name="AutoDismissSlider" Minimum="5" Maximum="60"
                        Value="15" IsSnapToTickEnabled="True" TickFrequency="5"
                        ValueChanged="AutoDismissSlider_OnValueChanged" />

                <!-- Opacity -->
                <TextBlock FontSize="11" Foreground="{StaticResource DimText}" Margin="0,12,0,4">
                    <Run Text="Tooltip opacity: " />
                    <Run x:Name="OpacityValueText" Text="93" />
                    <Run Text="%" />
                </TextBlock>
                <Slider x:Name="OpacitySlider" Minimum="50" Maximum="100"
                        Value="93" IsSnapToTickEnabled="True" TickFrequency="1"
                        ValueChanged="OpacitySlider_OnValueChanged" />

                <!-- Account Name -->
                <TextBlock Text="Account Name" FontSize="11" Foreground="{StaticResource DimText}"
                           Margin="0,12,0,4" />
                <TextBox x:Name="AccountNameTextBox" FontSize="11"
                         Background="#22FFFFFF" Foreground="#CCCCCC"
                         BorderBrush="#33FFFFFF" Padding="6,4"
                         Height="26" />

                <!-- Dream Build Section -->
                <Rectangle Height="1" Fill="{StaticResource SeparatorBrush}" Margin="0,12,0,10" />
                <TextBlock Text="Dream Build" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource BrightText}" Margin="0,0,0,8" />

                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="New" Style="{StaticResource ActionButton}"
                            Click="NewProfileButton_OnClick" Margin="4,0,0,0" />
                    <ComboBox x:Name="ProfileComboBox" FontSize="12"
                              SelectionChanged="ProfileComboBox_OnSelectionChanged"
                              Background="#22FFFFFF" Foreground="Black" Height="28" />
                </DockPanel>

                <TextBlock Text="Archetype" FontSize="11" Foreground="{StaticResource DimText}" Margin="0,0,0,4" />
                <ComboBox x:Name="ArchetypeComboBox" FontSize="12"
                          SelectionChanged="ArchetypeComboBox_OnSelectionChanged"
                          Background="#22FFFFFF" Foreground="Black" Height="28" />

                <TextBlock Text="Display Mode" FontSize="11" Foreground="{StaticResource DimText}" Margin="0,8,0,4" />
                <ComboBox x:Name="DisplayModeComboBox" FontSize="12"
                          SelectionChanged="DisplayModeComboBox_OnSelectionChanged"
                          Background="#22FFFFFF" Foreground="Black" Height="28" />

                <UniformGrid x:Name="DreamBuildGrid" Columns="2" Margin="0,8,0,0" />

                <Border x:Name="DreamSearchPanel" Visibility="Collapsed"
                        Margin="0,8,0,0" Padding="8" CornerRadius="6"
                        Background="#22FFFFFF">
                    <StackPanel>
                        <TextBlock x:Name="DreamSearchSlotLabel" FontSize="11"
                                   Foreground="{StaticResource AccentGold}" Margin="0,0,0,4" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Search" Style="{StaticResource ActionButton}"
                                    Click="DreamSearchButton_OnClick" Margin="4,0,0,0" />
                            <TextBox x:Name="DreamSearchTextBox" FontSize="11"
                                     Background="#22FFFFFF" Foreground="#CCCCCC"
                                     BorderBrush="#33FFFFFF" Padding="6,4" Height="26" />
                        </DockPanel>
                        <StackPanel x:Name="DreamSearchResults" Margin="0,4,0,0" />
                        <Button x:Name="DreamClearButton" Content="Clear slot" Style="{StaticResource ActionButton}"
                                Click="DreamClearButton_OnClick" Margin="0,4,0,0"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Rectangle Height="1" Fill="{StaticResource SeparatorBrush}" Margin="0,12,0,10" />

                <!-- POESESSID -->
                <TextBlock Text="POESESSID" FontSize="11" Foreground="{StaticResource DimText}"
                           Margin="0,0,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PoeSessIdTextBox" FontSize="11"
                             Background="#22FFFFFF" Foreground="#CCCCCC"
                             BorderBrush="#33FFFFFF" Padding="6,4"
                             Height="26" />
                    <Button Grid.Column="1" Content="Save" Style="{StaticResource ActionButton}"
                            Click="SaveSettingsButton_OnClick" Margin="8,0,0,0"
                            VerticalAlignment="Center" />
                </Grid>

                <!-- Status text -->
                <TextBlock x:Name="SettingsStatusText" FontSize="10"
                           Foreground="{StaticResource AccentGreen}"
                           Margin="0,8,0,0" Visibility="Collapsed" />

                <!-- Update Stat Definitions -->
                <Rectangle Height="1" Fill="{StaticResource SeparatorBrush}" Margin="0,12,0,10" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Update Now" Style="{StaticResource ActionButton}"
                            Click="UpdateStatDefsButton_OnClick" />
                    <StackPanel>
                        <TextBlock Text="Stat Definitions" FontSize="11"
                                   Foreground="{StaticResource BrightText}" />
                        <TextBlock x:Name="StatDefsVersionText" FontSize="10"
                                   Foreground="{StaticResource DimText}" />
                    </StackPanel>
                </DockPanel>

                <!-- Exit button -->
                <Rectangle Height="1" Fill="{StaticResource SeparatorBrush}" Margin="0,12,0,10" />
                <Button Content="Exit PoE2Overlay" Click="ExitButton_OnClick"
                        Background="#33FF4444" Foreground="#FF8888"
                        BorderThickness="0" Padding="12,6" Cursor="Hand" FontSize="11">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#55FF4444" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
